@startuml component_final
!theme plain
title "BrokerX - Component Architecture"

package "Frontend Layer" {
  component "React Frontend" as reactui
}

package "Gateway Layer" {
  component "API Gateway" as gateway
}

package "Microservices Layer" {
  
  component "Auth Service" as authsvc {
    [AuthController]
    [AuthRepository]
  }

  component "Order Service" as ordersvc {
    [OrderController]
    [SagaOrchestrator]
    [OrderRepository]
  }

  component "Matching Service" as matchingsvc {
    [MatchingEngine]
    [MatchingRepository]
  }
  
  component "Client Service" as clientsvc {
    [ClientRepository]
  }
  
  component "Wallet Service" as walletsvc {
    [WalletRepository]
  }
}

package "Infrastructure Layer" {
  component "RabbitMQ Broker" as mq {
    queue "ORDER_QUEUE"
    queue "MATCHING_QUEUE"
  }
  
  component "WebSocket Server" as ws
}

package "Persistence Layer" {
  database "AuthDB (H2)" as authdb
  database "ClientDB (H2)" as clientdb
  database "WalletDB (H2)" as walletdb
  database "OrderDB (H2)" as orderdb
  database "MatchingDB (H2)" as matchingdb
}

' --- Connexions ---

' Flux Principal
reactui --> gateway : HTTPS
reactui <.. ws : WebSocket Events

' Gateway Routing
gateway --> authsvc : REST
gateway --> clientsvc : REST
gateway --> walletsvc : REST
gateway --> ordersvc : REST

' Communication Inter-Services
ordersvc ..> gateway : Feign Client
clientsvc ..> gateway : Feign Client

' Messaging (Event-Driven)
ordersvc --> mq : Publish
mq --> matchingsvc : Subscribe
matchingsvc --> mq : Publish
mq --> ordersvc : Subscribe

' WebSocket Updates
ordersvc --> ws : Push Updates

' --- CORRECTION MAJEURE ICI ---
' Chaque Repository interne pointe DIRECTEMENT vers sa DB
[AuthRepository] --> authdb
[ClientRepository] --> clientdb
[WalletRepository] --> walletdb
[OrderRepository] --> orderdb
[MatchingRepository] --> matchingdb

note right of ordersvc
**SAGA Pattern**
Orchestration locale
via SagaOrchestrator
end note

note bottom of mq
**Decoupling**
Aucun lien direct HTTP
entre Order et Matching
end note

@enduml