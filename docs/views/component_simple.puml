@startuml component_simple
title BrokerX Component Diagram - Simplified Architecture

!define BUSINESS_COLOR #E8F4FD
!define INFRASTRUCTURE_COLOR #FFF2CC
!define DATA_COLOR #F8CECC

package "Frontend Layer" as frontend_layer {
  component "React UI" as reactui {
    [WebSocket Client]
    [API Service Layer]
    [Auth Context]
  }
}

package "API Gateway Layer" as gateway_layer {
  component "Spring Cloud Gateway" as gateway {
    [JWT Validator]
    [Route Configuration]
    [CORS Handler]
  }
}

package "Business Services Layer" as business_layer {
  
  component "Auth Service" as authsvc {
    [AuthController]
    [AuthService + JWT + Email]
    [UserCredentialRepository]
  }
  
  component "Client Service" as clientsvc {
    [ClientController]
    [ClientService]
    [ClientRepository]
    [AuthClient (OpenFeign)]
  }
  
  component "Wallet Service" as walletsvc {
    [WalletController]
    [WalletService]
    [WalletRepository]
  }
  
  component "Order Service" as ordersvc {
    [OrderController]
    [OrderSagaOrchestrator]
    [OrderService]
    [OrderRepository]
    [OpenFeign Clients]
    [WebSocket Publisher]
  }
  
  component "Matching Service" as matchingsvc {
    [OrderMatchingService]
    [Market Maker Engine]
    [ScheduledExecutor]
    [MatchingRepository]
  }
}

package "Infrastructure Layer" as infra_layer {
  
  component "Message Broker" as mq {
    queue "ORDER_QUEUE"
    queue "MATCHING_QUEUE"
    [RabbitMQ + JSON]
  }
  
  component "WebSocket Infrastructure" as ws {
    [STOMP Protocol]
    [User Queues]
  }
}

package "Persistence Layer" as data_layer {
  component "Data Access" as dataaccess {
    [JPA/Hibernate]
  }
  
  database "AuthDB (H2)" as authdb
  database "ClientDB (H2)" as clientdb
  database "WalletDB (H2)" as walletdb
  database "OrderDB (H2)" as orderdb
  database "MatchingDB (H2)" as matchingdb
}

' Main flow connections
reactui --> gateway : REST API
reactui ..> ws : WebSocket

gateway --> authsvc : /auth/**
gateway --> clientsvc : /clients/**
gateway --> walletsvc : /wallet/**
gateway --> ordersvc : /orders/**

' Inter-service communication
ordersvc --> gateway : OpenFeign calls
clientsvc --> gateway : Auth validation

' Message queue flow
ordersvc --> mq : Publish orders
mq --> matchingsvc : Consume orders
matchingsvc --> mq : Publish trades
mq --> ordersvc : Consume trades

' WebSocket flow
ordersvc --> ws : Real-time updates
ws ..> reactui : Notifications

' Data persistence
authsvc --> dataaccess
clientsvc --> dataaccess
walletsvc --> dataaccess
ordersvc --> dataaccess
matchingsvc --> dataaccess

dataaccess --> authdb
dataaccess --> clientdb
dataaccess --> walletdb
dataaccess --> orderdb
dataaccess --> matchingdb

note right of ordersvc
**SAGA Orchestrator**
- Distributed transactions
- Compensation logic
- Service coordination
end note

note bottom of mq
**Asynchronous Communication**
- Event-driven architecture
- Loose coupling
- Scalable messaging
end note

note left of ws
**Real-time Updates**
- SockJS fallback
- User-specific channels
- Order notifications
end note

@enduml