@startuml rdcu_uc04_diffusion_donnees
title RDCU UC04b - Génération et diffusion des données de marché

participant ":SpringTaskScheduler" as Scheduler
participant ":MarketDataService" as BusinessService
participant ":userSubscriptions" as SubsMap
participant ":lastPrices" as PriceCache
participant ":SimpMessagingTemplate" as MessageTemplate
participant ":Client" as Client

-> Scheduler : @Scheduled(fixedRate = 1000)
activate Scheduler

Scheduler -> BusinessService : broadcastMarketData()
activate BusinessService

BusinessService -> SubsMap : entrySet()
SubsMap --> BusinessService : userSubscriptions

alt userSubscriptions not empty
    loop Pour chaque utilisateur abonné
        BusinessService -> BusinessService : generateMarketQuote(symbol)
        
        BusinessService -> PriceCache : get(symbol)
        PriceCache --> BusinessService : currentPrice
        
        BusinessService -> BusinessService : calculateNewPrice()
        note right : Volatility ±2%, spread 0.1%
        
        BusinessService -> PriceCache : put(symbol, newPrice)
        
        create participant ":MarketQuote" as Quote
        BusinessService -> Quote : new MarketQuote(symbol, bid, ask, price, volume)
        
        BusinessService -> MessageTemplate : convertAndSendToUser(userEmail, "/queue/quotes", quote)
        MessageTemplate --> Client : Real-time market quote
    end
else
    BusinessService -> BusinessService : return (no subscriptions)
end

deactivate BusinessService
deactivate Scheduler

note over BusinessService, Client
    Processus automatique toutes les secondes
    Génération de prix réalistes avec volatility
    Diffusion via WebSocket STOMP
end note

@enduml
                
                BusinessService -> BusinessService : double changePercent = (change/currentPrice)*100
                
                BusinessService -> Quote : new MarketQuote(symbol, bid, ask, newPrice, volume)
                activate Quote
                Quote --> BusinessService : marketQuote
                
                BusinessService -> Quote : setChange(change)
                BusinessService -> Quote : setChangePercent(changePercent)
                Quote --> BusinessService : marketQuote configured
                deactivate Quote
                
                deactivate BusinessService
                
                BusinessService -> MessageTemplate : convertAndSendToUser(userEmail, "/queue/quotes", marketQuote)
                activate MessageTemplate
                MessageTemplate -> MessageTemplate : Résoudre la destination utilisateur\n/user/{userEmail}/queue/quotes
                MessageTemplate --> BusinessService : Message sent
                deactivate MessageTemplate
            end
        end
    end
else
    BusinessService -> BusinessService : return early (no active subscriptions)
end

deactivate BusinessService
deactivate Scheduler

note over BusinessService, MessageTemplate
    Le processus se répète automatiquement
    toutes les secondes grâce à @Scheduled
    
    Les prix évoluent de façon réaliste avec:
    - Volatilité de ±2%
    - Spread bid/ask de 0.1%
    - Volume aléatoire entre 100-10000
    - Persistance des prix entre les cycles
end note

@enduml