@startuml rdcu_uc06_modify
title RDCU - UC06: Modification d'un ordre existant (avec Outbox Pattern)

participant ":OrderController" as Controller
participant ":OrderSagaOrchestrator" as Saga
participant ":OrderRepository" as OrderRepo
participant "order:Order" as Order
participant ":WalletServiceClient" as WalletClient
participant ":ClientServiceClient" as ClientClient
participant ":OutboxService" as OutboxService
participant ":OutboxEventRepository" as OutboxRepo

Controller -> Saga : modifyOrderSaga(orderId, email, newPrice, newQuantity)
activate Saga

Saga -> OrderRepo : findByOrderId(orderId)
OrderRepo --> Saga : order

alt order not found or not PENDING
    Saga --> Controller : SagaResult(false, "Order cannot be modified")
end

Saga -> Saga : calculateNewTotal(newPrice, newQuantity, order)

alt orderType == "BUY"
    Saga -> WalletClient : getBalance(email, email)
    activate WalletClient
    note right of WalletClient
        @FeignClient(url="http://gateway:8080")
        Mapping:/api/wallet/balance
    end note
    WalletClient --> Saga : ResponseEntity<Double>
    deactivate WalletClient
    
    alt insufficient balance for new total
        Saga --> Controller : SagaResult(false, "Insufficient funds")
    end
else orderType == "SELL"
    note right of Saga : No balance check needed for SELL orders
end

Saga -> Order : setPrice(newPrice)
Saga -> Order : setQuantity(newQuantity)
Saga -> OrderRepo : save(order)

' Outbox Pattern Integration
Saga -> Saga : generateSagaId("modify-saga-" + orderId + "-" + timestamp)
Saga -> OutboxService : publishOrderModifiedBySaga(orderId, email, sagaId, newPrice, newQuantity)
activate OutboxService

note right of OutboxService : Creates transactional outbox event\nwithin same transaction as order update

create participant "outboxEvent:OutboxEvent" as OutboxEvent
OutboxService -> OutboxEvent : new OutboxEvent(sagaId, "SagaOrderModified", payloadJson)
OutboxService -> OutboxRepo : save(outboxEvent)
OutboxService --> Saga : void
deactivate OutboxService

note over OutboxService
    Scheduled processing (@Scheduled)
    processes events every 5 seconds
end note

Saga --> Controller : SagaResult(true, "Modification event published to outbox")
deactivate Saga

' Asynchronous outbox processing (separate thread)
activate OutboxService
OutboxService -> OutboxRepo : findUnprocessedEventsReadyForRetry()
OutboxRepo --> OutboxService : List<OutboxEvent>

loop for each unprocessed event
    OutboxService -> OutboxService : processEvent(outboxEvent)
    
    create participant "orderDto:OrderDto" as OrderDto
    OutboxService -> OrderDto : new OrderDto()
    OutboxService -> OrderDto : setStatus("MODIFIED")
    OutboxService -> OrderDto : setPrice(modifiedPrice)
    OutboxService -> OrderDto : setQuantity(modifiedQuantity)
    
    create participant ":OrderMessageProducer" as Producer
    OutboxService -> Producer : sendModifiedOrderToMatchingService(orderDto)
    
    OutboxService -> OutboxEvent : markAsProcessed()
    OutboxService -> OutboxRepo : save(outboxEvent)
end

deactivate OutboxService

@enduml

@enduml