@startuml rdcu_uc05_placement_ordre_merged
title RDCU - UC05: Placement d'ordre

skinparam style strictuml
skinparam noteBackgroundColor #FEFECE
skinparam noteBorderColor #A80036

actor "Client" as Actor
participant ":Gateway" as Gateway
participant ":OrderController" as Controller
participant ":OrderService" as Service
participant ":WalletServiceClient" as WalletClient
participant ":ClientServiceClient" as ClientClient
participant ":OrderRepository" as Repo
participant ":OrderMessageProducer" as Producer
queue ":RabbitTemplate" as Queue

Actor -> Gateway : POST /api/orders/placeOrder\n{symbol, qty, type="BUY"}
activate Gateway

    Gateway -> Gateway : Validate JWT\nExtract email
    
    Gateway -> Controller : placeOrder(email, symbol, qty, "BUY")
    activate Controller
    
    ' --- Validation Layer (Basé sur votre code OrderController) ---
    Controller -> Controller : validateSymbol(symbol)
    
    alt Symbole Invalide (ETF_PRICES.containsKey == false)
        Controller --> Gateway : 400 Bad Request "Symbol not found"
        Gateway --> Actor : 400 Bad Request
    else Symbole Valide
        
        Controller -> Controller : price = ETF_PRICES.get(symbol)
        
        Controller -> Service : acheterAction(email, symbol, price, qty)
        activate Service
        
        ' --- 1. Vérification Solde (Infrastructure Call) ---
        ' Signature: getBalance(String authenticatedUser, String ownerEmail)
        Service -> WalletClient : getBalance(email, email)
        activate WalletClient
            
            note right of WalletClient
                @FeignClient(url="http://gateway:8080")
                Mapping:/api/wallet/balance
                Header:X-Authentificated-User
            end note
            
            WalletClient -> Gateway : GET /api/wallet/balance\nHeader X-Authenticated-User: email
            activate Gateway
            Gateway --> WalletClient : 200 OK (Body: balance)
            deactivate Gateway
            
        WalletClient --> Service : ResponseEntity balance<Double>
        deactivate WalletClient
        
        
        alt Fonds Insuffisants
            Service --> Controller : message error: "Solde insuffisant"
            Controller --> Gateway : 400 Bad Request "Order failed"
            Gateway --> Actor : 400 Bad Request
        else Fonds OK
        
            ' --- 2. Récupération ID Client (Infrastructure Call) ---
            ' Signature: getByEmail(String authenticatedUser, String email)
            Service -> ClientClient : getByEmail(email, email)
            note right of ClientClient
                @FeignClient(url="http://gateway:8080")
                Mapping: /api/clients/getByEmail
                Header: X-Authenticated-User
            end note

            activate ClientClient
                ClientClient -> Gateway : HTTP GET /api/clients/getByEmail
                activate Gateway
                Gateway --> ClientClient : 200 OK (Body: clientId)
                deactivate Gateway
            ClientClient --> Service : ResponseEntity<Integer>(clientId)
            deactivate ClientClient
            
            ' --- 3. Persistance (Logique Domaine) ---
            ' Explicit object creation as requested
            Service -> Service : Order order = new Order(clientId, symbol, price, qty, "BUY", PENDING)
            
            Service -> Repo : save(order)
            activate Repo
            Repo --> Service : savedOrder
            deactivate Repo
            
            ' --- 4. Envoi Asynchrone (Infrastructure RabbitMQ) ---
            ' Explicit DTO creation as requested
            Service -> Service : OrderDto orderDto = new OrderDto(savedOrder)
            
            Service -> Producer : sendNewOrderToMatchingService(orderDto)
            activate Producer
                Producer -> Queue : convertAndSend("orderQueue", orderDto)
            deactivate Producer
            
            Service --> Controller : true
            
            Controller --> Gateway : 200 OK "Order submitted"
            Gateway --> Actor : 200 OK
        end
    end
    deactivate Service
    deactivate Controller

deactivate Gateway
@enduml