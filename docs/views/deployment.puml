@startuml deployment
!theme plain
skinparam componentStyle rectangle

title BrokerX - Deployment Diagram (with Prometheus Scraping)

actor "Client Browser" as user

node "Docker Host" {
    
    node "frontend" <<container>> {
        artifact "React App" as react
        note right: :5173
    }

    ' On utilise l'alias gateway_node pour éviter le conflit d'ID
    node "gateway" as gateway_node <<container>> {
        artifact "Gateway JAR" as gateway
        file "nginx.conf"
        note right: :8080
    }
    
    package "Microservices" {
        node "auth-service" <<container>> {
            artifact "Auth JAR" as auth
            note right: :8081
        }
        
        node "client-service" <<container>> {
            artifact "Client JAR" as client
            note right: :8082
        }
        
        node "wallet-service" <<container>> {
            artifact "Wallet JAR" as wallet
            note right: :8083
        }
        
        node "order-service" <<container>> {
            artifact "Order JAR" as order
            note right: :8084
        }
        
        node "matching-service" <<container>> {
            artifact "Matching JAR" as matching
            note right: :8085
        }
        
        node "market-data-service" <<container>> {
            artifact "Market JAR" as market
            note right: :8086
        }
    }
    
    node "rabbitmq" <<container>> {
        component "RabbitMQ" as rabbit
        note right: :5672
    }
    
    package "Monitoring" {
        node "prometheus" <<container>> {
            component "Prometheus" as prom
            note right: :9090
        }
        
        node "grafana" <<container>> {
            component "Grafana" as graf
            note right: :3000
        }
        
        node "swagger-ui" <<container>> {
            component "Swagger UI" as swagger
            note right: :8089
        }
    }
    
    database "auth-data" as db1
    database "wallet-data" as db2
    database "order-data" as db3
    database "matching-data" as db4
}

' --- Flux Utilisateur (User Traffic) ---
user --> react
react --> gateway : HTTP (8080)

gateway --> auth
gateway --> client
gateway --> wallet
gateway --> order
gateway --> matching
gateway --> market

' --- Flux Inter-Services (Async) ---
order ..> gateway
order <--> rabbit
matching <--> rabbit

' --- Flux Bases de Données ---
auth --> db1
wallet --> db2
order --> db3
matching --> db4

' --- Flux Monitoring (Prometheus Scraping) ---
' Prometheus tire (pull) les métriques depuis les endpoints Actuator
prom .[#blue].> gateway : /actuator/prometheus
prom .[#blue].> auth : /actuator/prometheus
prom .[#blue].> client : /actuator/prometheus
prom .[#blue].> wallet : /actuator/prometheus
prom .[#blue].> order : /actuator/prometheus
prom .[#blue].> matching : /actuator/prometheus
prom .[#blue].> market : /actuator/prometheus

' Grafana lit Prometheus
graf -> prom : Query Data

@enduml