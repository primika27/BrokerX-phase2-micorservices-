@startuml deployment_refined
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 40

title "BrokerX - Deployment Diagram"

actor "Client\n(Browser)" as user

node "Host Server (Linux/Cloud VM)" as host {

    node "Docker Engine" {
    
        node "frontend-container" <<Docker>> {
            artifact "react-app-dist" as react
            note right: Port 3000
        }

        node "gateway-container" <<Docker>> {
            artifact "brokerx-gateway.jar" as gw_jar
            note right: Port 8080
        }

        package "Backend Containers" {
            node "auth-service" <<Docker>> {
                artifact "brokerx-auth.jar" as auth_jar
            }
            
            node "order-service" <<Docker>> {
                artifact "brokerx-order.jar" as order_jar
            }
            
            node "wallet-service" <<Docker>> {
                artifact "brokerx-wallet.jar" as wallet_jar
            }
            
            node "matching-service" <<Docker>> {
                artifact "brokerx-matching.jar" as match_jar
            }
            
            node "market-data-service" <<Docker>> {
                artifact "brokerx-market.jar" as market_jar
            }
        }

        node "rabbitmq-container" <<Docker>> {
            component "RabbitMQ Broker" as mq
            note right: Port 5672\nMgmt: 15672
        }
    }

    folder "Host Volumes (Persistence)" as volumes {
        file "/var/lib/brokerx/auth/h2.db" as vol_auth
        file "/var/lib/brokerx/wallet/h2.db" as vol_wallet
        file "/var/lib/brokerx/order/h2.db" as vol_order
        file "/var/lib/brokerx/matching/h2.db" as vol_match
    }
}

' --- Flux Réseau ---

' Entrée externe
user --> react : HTTPS
react --> gw_jar : REST / WSS

' Routage Gateway vers les JARs
gw_jar --> auth_jar : :8081
gw_jar --> wallet_jar : :8083
gw_jar --> order_jar : :8084
gw_jar --> match_jar : :8085
gw_jar --> market_jar : :8086

' Communication Inter-Services (Via Gateway comme indiqué dans votre design)
order_jar ..> gw_jar : Feign Calls

' Messaging Asynchrone
order_jar <--> mq : AMQP (Orders)
match_jar <--> mq : AMQP (Trades)

' Persistance (Le JAR écrit sur le disque monté)
auth_jar --> vol_auth : Mount /data
wallet_jar --> vol_wallet : Mount /data
order_jar --> vol_order : Mount /data
match_jar --> vol_match : Mount /data

note bottom of volumes
  **Bind Mounts**
  Assure la persistance des fichiers H2
  même si les conteneurs redémarrent.
end note

@enduml