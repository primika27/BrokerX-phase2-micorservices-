@startuml rdcu_uc06_cancel
title RDCU - UC06: Annulation d'un ordre existant

participant ":OrderController" as Controller
participant ":OrderSagaOrchestrator" as Saga
participant ":OrderRepository" as OrderRepo
participant "order:Order" as Order
participant ":WalletServiceClient" as WalletClient
participant ":ClientServiceClient" as ClientClient
participant ":OrderMessageProducer" as Producer

Controller -> Saga : cancelOrderSaga(orderId, email)
activate Saga

Saga -> OrderRepo : findByOrderId(orderId)
OrderRepo --> Saga : order

alt order not found
    Saga --> Controller : SagaResult(false, "Order not found")
else order not PENDING
    Saga --> Controller : SagaResult(false, "Order cannot be cancelled")
end

Saga -> Order : setStatus(CANCELLED)
Saga -> OrderRepo : save(order)

' CORRECTION 1 : Utilisation de la syntaxe note / end note pour le multi-lignes
note right of Saga 
  No wallet refund needed
  (PENDING orders are never debited)
end note

' CORRECTION 2 : Suppression du mot clé "participant" après create
create "orderDto:OrderDto" as OrderDto
Saga -> OrderDto : new OrderDto()
Saga -> OrderDto : setStatus("CANCELLED")

Saga -> Producer : sendCancelledOrderToMatchingService(orderDto)

Saga --> Controller : SagaResult(true)
deactivate Saga

' CORRECTION 3 : Une seule fin
@enduml