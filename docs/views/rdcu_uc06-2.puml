@startuml rdcu_uc06_cancel
title RDCU - UC06: Annulation d'un ordre existant (Order Service Architecture)

' Participants - Real Architecture
participant ":OrderController" as Controller <<Infrastructure>>
participant ":OrderSagaOrchestrator" as Saga <<Application>>
participant ":OrderRepository" as OrderRepo <<Infrastructure>>
participant "order:Order" as Order <<Domain>>
participant ":WalletServiceClient" as WalletClient <<Infrastructure>>
participant ":ClientServiceClient" as ClientClient <<Infrastructure>>
participant ":OrderMessageProducer" as Producer <<Infrastructure>>
participant "sagaResult:SagaResult" as Result <<Domain>>
participant ":SimpMessagingTemplate" as WebSocket <<Infrastructure>>

' Sequence - Actual Implementation
Controller -> Controller : cancelOrder(orderId, clientEmail)
activate Controller

note right of Controller : **@DeleteMapping("/{orderId}")**\n**Real REST endpoint**

' Direct call to SAGA (no OrderService intermediary)
Controller -> Saga : cancelOrderSaga(orderId, clientEmail)
activate Saga

' Step 1: Validate order exists and is PENDING
note right of Saga : **Step 1: Validate Order**
Saga -> OrderRepo : findById(orderId)
activate OrderRepo
OrderRepo --> Saga : Optional<Order>
deactivate OrderRepo

alt order not found
    create Result
    Saga -> Result : new SagaResult(false)
    Saga -> Result : setErrorMessage("Order not found")
    Saga --> Controller : sagaResult
    note right : Exit early - no rollback needed
end

Saga -> Order : getStatus()
Order --> Saga : status

alt status != PENDING
    create Result
    Saga -> Result : new SagaResult(false)
    Saga -> Result : setErrorMessage("Order cannot be cancelled")
    Saga --> Controller : sagaResult
    note right : Exit early - only PENDING orders can be cancelled
end

' Step 2: Verify ownership
note right of Saga : **Step 2: Verify Ownership**
Saga -> ClientClient : getByEmail(clientEmail, clientEmail)
activate ClientClient
ClientClient --> Saga : ResponseEntity<Integer>
deactivate ClientClient

Saga -> Order : getClientId()
Order --> Saga : orderClientId

alt clientId doesn't match
    create Result
    Saga -> Result : new SagaResult(false)
    Saga -> Result : setErrorMessage("Unauthorized")
    Saga --> Controller : sagaResult
    note right : Exit early - user doesn't own this order
end

' Step 3: Mark order as CANCELLED
note right of Saga : **Step 3: Update Order Status**
Saga -> Order : setStatus(OrderStatus.CANCELLED)
Saga -> OrderRepo : save(order)
activate OrderRepo
OrderRepo --> Saga : Order
deactivate OrderRepo

' Step 4: Refund wallet (only for BUY orders)
note right of Saga : **Step 4: Refund Wallet**
Saga -> Order : getOrderType()
Order --> Saga : orderType

alt orderType == "BUY"
    Saga -> Order : getPrice()
    Order --> Saga : price
    Saga -> Order : getQuantity()
    Order --> Saga : quantity
    
    note right of Saga : Calculate refund:\nrefundAmount = price * quantity
    
    Saga -> ClientClient : getEmailById(orderClientId, clientEmail)
    activate ClientClient
    ClientClient --> Saga : ResponseEntity<String>
    deactivate ClientClient
    
    Saga -> WalletClient : walletTransaction(userEmail, userEmail, refundAmount, "CREDIT")
    activate WalletClient
    WalletClient --> Saga : ResponseEntity<String>
    deactivate WalletClient
    
    alt wallet refund failed
        note right of Saga : Transaction rolls back automatically\n(@Transactional annotation)
        create Result
        Saga -> Result : new SagaResult(false)
        Saga -> Result : setErrorMessage("Refund failed")
        Saga --> Controller : sagaResult
    end
else orderType == "SELL"
    note right of Saga : No refund needed for SELL orders
end

' Step 5: Notify matching service
note right of Saga : **Step 5: Notify Matching Service**
Saga -> Order : getOrderId()
Order --> Saga : orderId
Saga -> Order : getSymbol()
Order --> Saga : symbol
Saga -> Order : getPrice()
Order --> Saga : price
Saga -> Order : getQuantity()
Order --> Saga : quantity
Saga -> Order : getOrderType()
Order --> Saga : orderType

create participant "orderDto:OrderDto" as OrderDto <<DTO>>
Saga -> OrderDto : new OrderDto()
Saga -> OrderDto : setOrderId(String.valueOf(orderId))
Saga -> OrderDto : setStockSymbol(symbol)
Saga -> OrderDto : setPrice(price)
Saga -> OrderDto : setQuantity(quantity)
Saga -> OrderDto : setOrderType(orderType)

Saga -> Producer : sendCancelledOrderToMatchingService(orderDto)
activate Producer
Producer --> Saga : void
deactivate Producer

' Step 6: Notify UI via WebSocket
note right of Saga : **Step 6: Notify UI via WebSocket**
Saga -> ClientClient : getEmailById(orderClientId, clientEmail)
activate ClientClient
ClientClient --> Saga : ResponseEntity<String>
deactivate ClientClient

create participant "updateMsg:OrderUpdateMessage" as UpdateMsg <<DTO>>
Saga -> UpdateMsg : new OrderUpdateMessage()
Saga -> UpdateMsg : setOrderId(orderId)
Saga -> UpdateMsg : setStatus(OrderStatus.CANCELLED)
Saga -> UpdateMsg : setMessage("Order cancelled successfully")

Saga -> WebSocket : convertAndSendToUser(userEmail, "/topic/order-updates", updateMsg)
activate WebSocket
WebSocket --> Saga : void
deactivate WebSocket

' Step 7: Create successful result
note right of Saga : **Step 7: Return Success**
create Result
Saga -> Result : new SagaResult(true)
Saga -> Result : setMessage("Order cancelled successfully")
Saga -> Result : addExecutedStep("Validated order and ownership")
Saga -> Result : addExecutedStep("Marked order as CANCELLED")
Saga -> Result : addExecutedStep("Refunded wallet")
Saga -> Result : addExecutedStep("Notified matching service")
Saga -> Result : addExecutedStep("Sent WebSocket notification")

Saga --> Controller : sagaResult
deactivate Saga

Controller --> "Frontend" : ResponseEntity.ok(response)

note right of Controller
  **ACTUAL ARCHITECTURE:**
  
  OrderController (REST endpoints):
  - @Autowired OrderSagaOrchestrator
  - DELETE /api/orders/{orderId} → cancelOrder()
  - Direct delegation to SAGA orchestrator
  
  SAGA Pattern Benefits:
  - Distributed transaction coordination  
  - Automatic rollback (@Transactional)
  - Multi-service orchestration (Wallet, Matching)
  - Clear compensation logic (refund wallet)
  
  **GRASP Patterns Applied:**
  - Controller: OrderController handles HTTP/REST concerns
  - Information Expert: Order knows its own state and business rules
  - Creator: Saga creates SagaResult, OrderDto, UpdateMessage
  - Low Coupling: Feign clients abstract inter-service communication
  - High Cohesion: Saga focuses purely on transaction orchestration
  - Protected Variations: Repository pattern shields from DB changes
  - Pure Fabrication: Saga is invented to handle distributed transactions
end note

@enduml
