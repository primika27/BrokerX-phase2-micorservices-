@startuml rdcu_uc04_connexion_websocket
title RDCU UC04a - Connexion WebSocket et abonnement aux données de marché

participant ":Frontend (React)" as Frontend
participant ":Gateway" as Gateway  
participant ":JwtAuthFilter" as AuthFilter
participant ":MarketDataWebSocketController" as WSController
participant ":MarketDataService" as BusinessService
participant ":userSubscriptions : Map<String, Set<String>>" as SubsMap
participant ":userSubscriptionTypes : Map<String, String>" as TypeMap

-> Frontend : connectWebSocket(jwtToken)
activate Frontend

Frontend -> Gateway : WebSocket handshake /ws/market-data\nUpgrade: websocket\nAuthorization: Bearer {jwt}
activate Gateway

Gateway -> AuthFilter : filter(exchange, chain)
activate AuthFilter

AuthFilter -> AuthFilter : validateJwtToken(jwt)
AuthFilter -> AuthFilter : extractUserEmail(jwt)
AuthFilter -> AuthFilter : addHeader("X-Authenticated-User", email)
AuthFilter --> Gateway : filterChain.doFilter()
deactivate AuthFilter

Gateway -> WSController : WebSocket connection established
activate WSController

WSController -> WSController : @EventListener(SessionConnectedEvent)\nhandleWebSocketConnectListener(event)
WSController -> WSController : Extract sessionId from event

note right WSController : Session WebSocket créée\nsessionId généré automatiquement

WSController --> Gateway : Connection successful
deactivate WSController
Gateway --> Frontend : WebSocket connected

Frontend -> Gateway : STOMP SEND /app/subscribe\n{ "symbols": ["AAPL", "GOOGL", "TSLA"] }
Gateway -> WSController : handleSubscription(symbols[], StompHeaderAccessor)
activate WSController

WSController -> WSController : extractUserEmail(headerAccessor)\nString userEmail = header.getFirstNativeHeader("X-Authenticated-User")

alt En-tête X-Authenticated-User présent
    WSController -> BusinessService : addSubscription(userEmail, symbols[], "quotes")
    activate BusinessService
    
    BusinessService -> BusinessService : validateSymbols(symbols[])
    note right : Vérifier que les symboles sont\ndans supportedSymbols
    
    BusinessService -> SubsMap : put(userEmail, validSymbolsSet)
    SubsMap --> BusinessService : previous subscription (if any)
    
    BusinessService -> TypeMap : put(userEmail, "quotes")
    TypeMap --> BusinessService : previous type (if any)
    
    BusinessService --> WSController : subscription added
    deactivate BusinessService
    
    WSController -> WSController : messagingTemplate.convertAndSendToUser(userEmail, "/queue/confirmation", confirmationData)
    WSController --> Frontend : STOMP MESSAGE /user/queue/confirmation\n{ "type": "subscription_confirmed", "symbols": [...] }

else En-tête manquant (requête non authentifiée)
    WSController -> WSController : messagingTemplate.convertAndSendToUser(sessionId, "/queue/error", errorData)
    WSController --> Frontend : STOMP MESSAGE /user/queue/error\n{ "type": "error", "message": "Authentification échouée" }
end

deactivate WSController
deactivate Gateway
deactivate Frontend

@enduml