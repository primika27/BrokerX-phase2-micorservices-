@startuml rdcu_uc04_connexion_websocket
title RDCU UC04a - Connexion WebSocket et abonnement aux données de marché

participant ":Gateway" as Gateway  
participant ":JwtAuthFilter" as AuthFilter
participant ":MarketDataWebSocketController" as WSController
participant ":MarketDataService" as BusinessService
participant ":userSubscriptions : Map<String, Set<String>>" as SubsMap
participant ":userSubscriptionTypes : Map<String, String>" as TypeMap

-> Gateway : WebSocket handshake /ws/market-data\nUpgrade: websocket\nAuthorization: Bearer {jwt}
activate Gateway

Gateway -> AuthFilter : filter(exchange, chain)
activate AuthFilter

AuthFilter -> AuthFilter : validateJwtToken(jwt)
AuthFilter -> AuthFilter : extractUserEmail(jwt)
AuthFilter -> AuthFilter : addHeader("X-Authenticated-User", email)
AuthFilter --> Gateway : filterChain.doFilter()
deactivate AuthFilter

Gateway -> WSController : WebSocket connection established
activate WSController

WSController -> WSController : @EventListener(SessionConnectedEvent)\nhandleWebSocketConnectListener(event)
WSController -> WSController : Extract sessionId from event

note right WSController : Session WebSocket créée\nsessionId généré automatiquement

WSController --> Gateway : Connection successful
deactivate WSController

Gateway -> WSController : STOMP SEND /app/subscribe\n{ "symbols": ["AAPL", "GOOGL", "TSLA"] }
Gateway -> WSController : subscribe(SubscriptionRequest, StompHeaderAccessor)
activate WSController

WSController -> WSController : extractUserEmailFromHeaders(headerAccessor)

alt userEmail != null (authentifié)
    WSController -> BusinessService : addSubscription(userEmail, symbols[], subscriptionType)
    activate BusinessService
    
    BusinessService -> BusinessService : validateSymbols(symbols[])
    BusinessService -> SubsMap : put(userEmail, validSymbolsSet)
    BusinessService -> TypeMap : put(userEmail, subscriptionType)
    BusinessService --> WSController : subscription added
    deactivate BusinessService
    
    WSController -> BusinessService : sendSubscriptionConfirmation(userEmail, symbols[])
    activate BusinessService
    BusinessService -> BusinessService : messagingTemplate.convertAndSendToUser(...)
    BusinessService --> WSController : STOMP MESSAGE confirmation sent
    deactivate BusinessService

else userEmail == null (authentification échouée)
    WSController -> BusinessService : sendError(sessionId, "Authentification échouée")
    activate BusinessService
    BusinessService --> WSController : STOMP MESSAGE error sent
    deactivate BusinessService
end

deactivate WSController
deactivate Gateway

@enduml