@startuml rdcu_uc05_consultation_holdings
title RDCU - UC05b: Consultation des holdings 
skinparam style strictuml
skinparam noteBackgroundColor #FEFECE
skinparam noteBorderColor #A80036

'--- Participants (Software Objects) ---
actor "Client (Actor)" as Actor
participant ":Gateway" as Gateway
participant ":OrderController" as Controller
participant ":OrderService" as Service
participant ":ClientServiceClient" as InfrastructureClient
participant ":OrderRepository" as Repo

'--- System Operation ---
Actor -> Gateway : GET /api/orders/holdings
activate Gateway

    note right of Gateway
        Gateway handles security 
        and routing (Infrastructure)
    end note

    Gateway -> Controller : getHoldings(clientEmail)
    activate Controller
    
    '--- Controller Delegation ---
    Controller -> Service : getHoldings(clientEmail)
    activate Service

        '--- Step 1: External Service Call (via Feign Interface) ---
        ' Ref: ClientServiceClient.java
        ' method: getByEmail(String authenticatedUser, String email)
        
        Service -> InfrastructureClient : getByEmail(clientEmail, clientEmail)
        activate InfrastructureClient
            
            note right of InfrastructureClient
                @FeignClient(url="http://gateway:8080")
                Mapping: /api/clients/getByEmail
                Header: X-Authenticated-User
            end note
            
            ' This shows the INTERNAL implementation of the Feign Client sending the request out
            InfrastructureClient -> Gateway : HTTP GET /api/clients/getByEmail\nHeader: X-Authenticated-User: clientEmail
            activate Gateway
            Gateway --> InfrastructureClient : HTTP 200 OK (Body: clientId)
            deactivate Gateway

        InfrastructureClient --> Service : ResponseEntity<Integer>(clientId)
        deactivate InfrastructureClient

        '--- Step 2: Domain Logic (Calculations) ---
        
        alt clientId found
            Service -> Service: getCurrentHoldings(clientId)
            Service -> Repo : findFilledOrdersByClientId(clientId)
            activate Repo
            Repo --> Service : Map<Holdings>
            deactivate Repo
            
            
            '--- Create Response ---
            Service -> Service : createResultMap(email, holdings, holdings.size)
            
            Service --> Controller : Map<String, Object> result
        else client not found
            Service --> Controller : Map (Error: Client not found)
        end

    deactivate Service

    Controller --> Gateway : ResponseEntity (JSON)
    deactivate Controller

Gateway --> Actor : Affichage des holdings sur /Dashboard
deactivate Gateway

@enduml