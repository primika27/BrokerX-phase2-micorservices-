@startuml classDiagram
title BrokerX - Simplified Class Diagram (Microservices Architecture)

package "Gateway Service" {
    class ApiGateway
    class JwtAuthFilter
}

package "AuthService" {
    class UserCredential {
        -email : String
        -passwordHash : String
        -status : UserStatus
    }
    
    enum UserStatus {
        PENDING, ACTIVE, INACTIVE
    }
}

package "ClientService" {
    class Client {
        -clientId : Long
        -email : String
        -name : String
    }
    
    interface ClientServiceClient
}

package "WalletService" {
    class Wallet {
        -ownerEmail : String
        -balance : BigDecimal
    }
    
    interface WalletServiceClient
}

package "OrderService" {
    class Order {
        -orderId : Long
        -symbol : String
        -price : BigDecimal
        -quantity : Integer
        -status : OrderStatus
        -orderType : OrderType
    }
    
    class OrderSagaOrchestrator
    class MatchingConsumer
    
    enum OrderStatus {
        PENDING, FILLED, CANCELLED
    }
    
    enum OrderType {
        BUY, SELL
    }
}

package "MatchingService" {
    class MatchingOrder {
        -orderId : String
        -stockSymbol : String
        -quantity : Integer
        -price : BigDecimal
        -orderType : OrderType
    }
    
    class OrderMatchingService
    class TradeDto
}

package "MarketDataService" {
    class MarketQuote {
        -symbol : String
        -bid : Double
        -ask : Double
        -lastPrice : Double
    }
    
    class MarketDataService
}

' Essential relationships
ApiGateway --> JwtAuthFilter
UserCredential --> UserStatus
Order --> OrderStatus
Order --> OrderType
MatchingOrder --> OrderType

' Cross-service relationships
ApiGateway --> AuthService
ApiGateway --> ClientService
ApiGateway --> WalletService
ApiGateway --> OrderService
ApiGateway --> MarketDataService

OrderSagaOrchestrator --> WalletServiceClient
OrderSagaOrchestrator --> ClientServiceClient
MatchingConsumer --> WalletServiceClient
MatchingConsumer --> ClientServiceClient

OrderService --> MatchingService : RabbitMQ
MatchingService --> OrderService : RabbitMQ

@enduml