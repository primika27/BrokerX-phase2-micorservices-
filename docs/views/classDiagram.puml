@startuml classDiagram
title BrokerX - Class Diagram (Microservices Architecture)

!define ENTITY class
!define SERVICE class
!define ENUM enum

package "AuthService" {
    ENTITY UserCredential {
        - id : Long
        - email : String
        - passwordHash : String
        - status : UserStatus
        - verificationToken : String
        - isVerified : boolean
        - otpExpiry : LocalDateTime
        + validatePassword(password : String) : boolean
        + generateOTP() : String
        + isOTPValid(otp : String) : boolean
    }
    
    ENUM UserStatus {
        PENDING
        ACTIVE
        INACTIVE
    }
}

package "ClientService" {
    ENTITY Client {
        - clientId : Long
        - name : String
        - email : String
        - isVerified : boolean
        - generateToken() : String
    }
}

package "WalletService" {
    ENTITY Wallet {
        - walletId : Long
        - ownerEmail : String
        - balance : BigDecimal
        + credit(amount : BigDecimal) : void
        + debit(amount : BigDecimal) : boolean
        + hasBalance(amount : BigDecimal) : boolean
    }
    
    ENTITY Transaction {
        - transactionId : Long
        - orderId : Long
        - type : TransactionType
        - amount : BigDecimal
        - dateTransaction : LocalDateTime
        - description : String
    }
    
    ENUM TransactionType {
        ORDER
        DEPOSIT
        WITHDRAWAL
    }
}

package "OrderService" {
    ENTITY Order {
        - orderId : Long
        - clientId : Long
        - symbol : String
        - price : BigDecimal
        - quantity : Integer
        - status : OrderStatus
        - orderType : OrderType
        - timestamp : LocalDateTime
        + calculateTotal() : BigDecimal
        + canModify() : boolean
    }
    
    ENTITY OutboxEvent {
        - id : Long
        - aggregateId : String
        - eventType : String
        - payload : String
        - createdAt : LocalDateTime
        - processedAt : LocalDateTime
        - retryCount : int
        - maxRetries : int
        - nextRetryAt : LocalDateTime
        + markAsProcessed() : void
        + incrementRetryCount() : void
        + canRetry() : boolean
    }
    
    SERVICE OrderSagaOrchestrator {
        + cancelOrderSaga(orderId, email) : SagaResult
        + modifyOrderSaga(orderId, email, newPrice, newQuantity) : SagaResult
    }
    
    SERVICE OutboxService {
        + publishOrderCancelledBySaga() : void
        + publishOrderModifiedBySaga() : void
        + processOutboxEvents() : void
    }
    
    ENUM OrderStatus {
        PENDING
        FILLED
        CANCELLED
        FAILED
    }
    
    ENUM OrderType {
        BUY
        SELL
    }
}

package "MatchingService" {
    ENTITY MatchingOrder {
        - id : Long
        - orderId : Long
        - stockSymbol : String
        - quantity : Integer
        - remainingQuantity : Integer
        - price : BigDecimal
        - orderType : OrderType
        - createdAt : LocalDateTime
        - status : MatchingStatus
        + isFullyMatched() : boolean
        + calculateMatch() : MatchResult
    }
    
    SERVICE OrderMatchingService {
        + processNewOrder() : void
        + cancelOrder() : void
        + modifyOrder() : void
        + executeTrade() : TradeResult
    }
    
    ENUM MatchingStatus {
        PENDING
        PARTIALLY_MATCHED
        FULLY_MATCHED
        CANCELLED
    }
}

package "MarketDataService" {
    ENTITY MarketQuote {
        - symbol : String
        - bid : Double
        - ask : Double
        - lastPrice : Double
        - timestamp : LocalDateTime
        + updatePrice() : void
        + getBidAskSpread() : Double
    }
    
    SERVICE MarketDataService {
        + publishMarketData() : void
        + getLatestQuote() : MarketQuote
    }
}

package "GatewayService" {
    SERVICE ApiGateway {
        + routeRequest() : void
        + authenticate() : boolean
    }
    
    SERVICE JwtAuthFilter {
        + validateToken() : boolean
        + extractClaims() : String
    }
}

' Core Business Relationships
Client ||--o{ Order : "places orders"
UserCredential ||--|| Client : "authenticates user"
Client ||--|| Wallet : "owns wallet"
Wallet ||--o{ Transaction : "records transactions"
Order ||--o{ Transaction : "generates transactions"

' Order Processing Flow
Order ||--|| MatchingOrder : "converts to matching order"
MatchingOrder ||--|| OrderMatchingService : "processed by matching engine"

' Saga + Outbox Pattern Architecture
OrderSagaOrchestrator --> Order : "orchestrates: modify(), cancel()"
OrderSagaOrchestrator --> OutboxService : "publishes events via outbox"
OutboxService --> OutboxEvent : "creates transactional events"
OutboxEvent --> OrderMatchingService : "triggers async processing"

' External Service Communications
OrderSagaOrchestrator ..> Client : "validates client via ClientService"
OrderSagaOrchestrator ..> Wallet : "checks balance via WalletService"

' Market Data Integration
MarketQuote --> OrderMatchingService : "provides real-time pricing"
OrderMatchingService --> MarketQuote : "updates market data"

' Gateway and Authentication
ApiGateway --> JwtAuthFilter : "delegates authentication"
JwtAuthFilter --> UserCredential : "validates credentials"
ApiGateway ..> OrderSagaOrchestrator : "routes order requests"

@enduml
' Essential relationships
ApiGateway --> JwtAuthFilter
UserCredential --> UserStatus
Order --> OrderStatus
Order --> OrderType
MatchingOrder --> OrderType

' Cross-service relationships
ApiGateway --> AuthService
ApiGateway --> ClientService
ApiGateway --> WalletService
ApiGateway --> OrderService
ApiGateway --> MarketDataService

' Saga + Outbox Pattern relationships
OrderSagaOrchestrator --> OutboxService : uses
OrderSagaOrchestrator --> WalletServiceClient : calls
OrderSagaOrchestrator --> ClientServiceClient : calls
OrderSagaOrchestrator --> SagaResult : creates

OutboxService --> OutboxEventRepository : uses
OutboxService --> OutboxEvent : manages
OutboxService --> OrderMessageProducer : delegates to
OutboxEvent --> OutboxEventRepository : persisted by

' Scheduled Processing (Outbox Pattern)
note right of OutboxService
    @Scheduled(fixedDelay = 5000)
    Processes unprocessed events
    with retry logic and 
    exponential backoff
end note

' Matching Service Integration
OrderService --> MatchingService : RabbitMQ via Outbox
MatchingService --> OrderService : RabbitMQ
RabbitMQConsumer --> OrderMatchingService : delegates to

MatchingConsumer --> WalletServiceClient : calls
MatchingConsumer --> ClientServiceClient : calls

' Hybrid Pattern Notes
note top of OrderSagaOrchestrator
    Saga Orchestrator coordinates
    business logic and uses 
    Outbox for reliable messaging
end note

note top of OutboxService
    Transactional event persistence
    with guaranteed delivery
    and automatic retry
end note

@enduml